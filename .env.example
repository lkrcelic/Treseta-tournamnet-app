# Copy to .env for local development. Production values live in the Vercel project's environment variables.

# Local Postgres (npm run dev:reset migrates and seeds it)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/treseta?schema=public"

# Signs the password-login session cookie; any long random string locally, a secret one in production
SECRET_KEY="change-me"

# Cookie names of the password login (Lucia) and the Google login (Auth.js)
AUTH_COOKIE="TresetaSession"
GOOGLE_AUTH_COOKIE="TresetaGoogleSession"

# The "Bye" team that a team without an opponent plays against; the standings SQL expects 0
BYE_ID=0

# Google login (optional locally)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
