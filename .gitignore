# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage
# routine reports (rutine/README.md, Report), local only
/reports/
# the E2E seed's manifest (ids of the generated world), written by every npm run seed:e2e
/e2e/seed/out/
# the suite's per-section servers, manifests, reports and traces (e2e/local/app.sh)
/e2e/local/run/
# e2e/run.sh's report of the whole suite (run.log, html/, results/)
/e2e/report/

# next.js
.next
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
# the production database connection (read-only checks)
.env.prod-db

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
node_modules
tsconfig.tsbuildinfo
.idea

# local leftovers, not part of the app
*.zip
tmp-file.ts
**/.idea/

# local env file (production values are in Vercel; see .env.example)
.env

# production dumps and the production connection string (users' password hashes, credentials)
/backups/

# .claude stays local (settings, worktrees), except the shared test skill and agents (skill testovi, agent e2e-reviewer)
/.claude/*
!/.claude/agents/
!/.claude/skills/
/.claude/skills/*
!/.claude/skills/testovi/
skills-lock.json
