# The app's environment for the local suite only (e2e/local/app.sh): made-up values, never production's. Treseta
# doesn't track .env, so the suite's servers take these; app.sh adds DATABASE_URL, NEXTAUTH_URL and CRON_SECRET.
SECRET_KEY=e2e-only-not-a-secret-0123456789abcdef0123456789abcdef
AUTH_COOKIE=TresetaSession
GOOGLE_AUTH_COOKIE=TresetaGoogleSession
BYE_ID=0
NEXTAUTH_SECRET=e2e-only-not-a-secret-fedcba9876543210fedcba9876543210
GOOGLE_CLIENT_ID=e2e-none
GOOGLE_CLIENT_SECRET=e2e-none
